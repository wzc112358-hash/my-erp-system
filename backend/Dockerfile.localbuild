# Production runtime image for binaries compiled on a developer machine or CI.
# Copy the CA bundle from the previous image without inheriting its application
# layers, so repeated deployments stay small and require no network access.
FROM my-erp-system-pocketbase-beijing:latest AS previous-runtime

FROM alpine:3.22

COPY --from=previous-runtime /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

WORKDIR /app

COPY pocketbase_newbin ./pocketbase
COPY pb_migrations ./pb_migrations

EXPOSE 8090

CMD ["./pocketbase", "serve", "--http=0.0.0.0:8090"]
